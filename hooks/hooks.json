{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/deny-grep.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Bash|mcp__.*code[-_]context.*__(sql|search)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/deny-grep.mjs\""
          }
        ]
      }
    ]
  }
}
