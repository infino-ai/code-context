# The fleet's gateway, on loopback where the demo expects it.
#
# The demo is configured with a database URL of http://127.0.0.1:9110/<db>; this
# is what puts the gateway there. It was a `socat` started by hand until the
# reboot that removed this host's service account took it down with nothing to
# bring it back.
#
# INFINO_GATEWAY is the gateway's address, written into /etc/infino/demo.env at
# launch rather than baked: it is the one thing about this image that differs
# per environment, and an image that hard-coded one deployment's load balancer
# could only ever serve that deployment.
[Unit]
Description=Forward 127.0.0.1:9110 to the Infino gateway
Documentation=https://github.com/infino-ai/code-context/blob/main/demo/host/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=infino-demo
Group=infino-demo
EnvironmentFile=/etc/infino/demo.env
ExecStart=/usr/bin/socat TCP-LISTEN:9110,fork,reuseaddr,bind=127.0.0.1 TCP:${INFINO_GATEWAY}
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
