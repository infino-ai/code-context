# TLS for the demo, when the host is public.
#
# Shipped in the image but caddy is DISABLED: a host behind the tailnet needs
# none of this, and a service listening on 443 that nothing routes to is a thing
# somebody later has to explain. launch-host.sh enables it when it is given a
# name.
#
# {$DEMO_NAME} comes from /etc/infino/demo.env. Behind a Cloudflare-proxied
# record the browser's certificate is Cloudflare's, and this end only has to
# encrypt the Cloudflare-to-origin hop: `tls internal` does that and is accepted
# by Cloudflare's "Full" SSL mode. It is NOT accepted by "Full (strict)", which
# wants a publicly trusted certificate — a Cloudflare Origin CA certificate in
# place of `tls internal` is how to get there.
#
# Let's Encrypt is unused on purpose: once the record is proxied, Cloudflare
# answers the HTTP-01 challenge rather than this host, so it cannot complete.
# DNS-01 would work and needs a Cloudflare API token.
{$DEMO_NAME} {
	tls internal

	# The run streams its events. Nothing is buffered, because a question can
	# take five minutes and its bars have to move the whole way.
	reverse_proxy 127.0.0.1:7777 {
		flush_interval -1
	}
}

# Arriving by address rather than by name is not a visitor of this demo: a
# proxied name always carries the Host header. Answering here rather than
# falling through keeps the origin from serving the page to whatever scans the
# address range.
:443 {
	tls internal
	respond "not here" 404
}
